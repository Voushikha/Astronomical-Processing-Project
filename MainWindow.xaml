<Window x:Class="kanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kanban"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:hw="http://schemas.hpod9.com/haley/wpf"
        xmlns:hm="http://schemas.hpod9.com/haley/mvvm"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
     
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid x:Name="mainWindow" Background="#FFC2CECE" >
        <Button x:Name="CalculateButton" Content="Calculate" HorizontalAlignment="Left" Height="25" Margin="40,34,0,0" VerticalAlignment="Top" Width="90" Foreground="#FFFFFCFC" Background="#FF2B1919" Click="Calculate_Click"/>
        <Button x:Name="ClearButton" Content="Clear" HorizontalAlignment="Left" Height="25" Margin="145,34,0,0" VerticalAlignment="Top" Width="90" Foreground="#FFFFFCFC" Background="#FF2B1919" Click="Clear_Click"/>
        <TextBox x:Name="txtBoxInputBlackhole" HorizontalAlignment="Left" Height="39" Margin="20,346,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="145" BorderBrush="#FF072FA5"/>
        <TextBox x:Name="txtBoxInputTemp" HorizontalAlignment="Left" Height="39" Margin="20,271,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="145" BorderBrush="#FF072FA5"/>
        <TextBox x:Name="txtBoxInputDistance" HorizontalAlignment="Left" Height="39" Margin="20,206,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="145" BorderBrush="#FF072FA5"/>
        <TextBox x:Name="txtBoxInputVelocity" HorizontalAlignment="Left" Height="40" Margin="20,137,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="145" BorderBrush="#FF072FA5"/>

        <TextBox x:Name="txtBoxOutputBlackhole" HorizontalAlignment="Left" Height="40" Margin="200,346,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" BorderBrush="#FF072FA5" IsReadOnly="True"/>
        <TextBox x:Name="txtBoxOutputTemp" HorizontalAlignment="Left" Height="40" Margin="200,273,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" BorderBrush="#FF072FA5" IsReadOnly="True"/>
        <TextBox x:Name="txtBoxOutputDistance" HorizontalAlignment="Left" Height="40" Margin="200,207,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" BorderBrush="#FF072FA5" IsReadOnly="True"/>
        <TextBox x:Name="txtBoxOutputVelocity" HorizontalAlignment="Left" Height="40" Margin="200,138,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" BorderBrush="#FF072FA5" IsReadOnly="True"/>
        <TextBox x:Name="txtBoxOutputResult" HorizontalAlignment="Left" Height="40" Margin="370,239,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" BorderBrush="#FF072FA5" IsReadOnly="True"/>

        <Label x:Name="InputSVlb" Content="Star Velocity" HorizontalAlignment="Left" Height="29" Margin="20,115,0,0"
               VerticalAlignment="Top" Width="145"/>
        <Label x:Name="OutputSVlb" Content="Star Velocity" HorizontalAlignment="Left" Height="30" Margin="200,115,0,0"
               VerticalAlignment="Top" Width="140"/>
        <Label  x:Name="InputSDlb" Content="Star Distance" HorizontalAlignment="Left" Height="30" Margin="20,186,0,0" VerticalAlignment="Top" Width="145"/>
        <Label x:Name="OutputSdlb" Content="Star Distance" HorizontalAlignment="Left" Height="30" Margin="200,186,0,0" VerticalAlignment="Top" Width="140"/>
        <Label x:Name="InputTClb" Content="Temperature Conversion" HorizontalAlignment="Left" Height="30" Margin="200,250,0,0" VerticalAlignment="Top" Width="140"/>
        <Label x:Name="OutputTClb" Content="Temperature Conversion" HorizontalAlignment="Left" Height="29" Margin="20,250,0,0" VerticalAlignment="Top" Width="145" />

        <Label x:Name="OutputBHlb" Content="Blackhole Event Horizon" HorizontalAlignment="Left" Height="30" Margin="200,325,0,0" VerticalAlignment="Top" Width="140"/>
        <Label x:Name="InputBEHlb" Content="Blackhole Event Horizon" HorizontalAlignment="Left" Height="29" Margin="20,325,0,0" VerticalAlignment="Top" Width="145" />
        <Label Content="Result" HorizontalAlignment="Left" Height="29" Margin="370,215,0,0" VerticalAlignment="Top" Width="145" />



        <Label x:Name="lbl_Input" Content="Input" HorizontalAlignment="Left" Height="25" Margin="25,79,0,0" VerticalAlignment="Top" Width="100" FontWeight="Bold"/>
        <Label Content="Output" HorizontalAlignment="Left" Height="30" Margin="210,84,0,0" VerticalAlignment="Top" Width="100" FontWeight="Bold"/>
        <Label Content="Font Style" HorizontalAlignment="Left" Height="26" Margin="675,158,0,0" VerticalAlignment="Top" Width="72"/>
        <Label Content="Language" HorizontalAlignment="Left" Height="26" Margin="660,272,0,0" VerticalAlignment="Top" Width="87"/>
        <Label Content="colorPkr" Margin="628,87,53,321"/>

        <xctk:ColorPicker x:Name="colorPicker"
                          Width="116" 
                          SelectedColorChanged="ColorPicker_SelectedColorChanged" 
                          HorizontalAlignment="Left" Margin="631,107,0,295" />

        <!-- Add Toggle Button for Night Mode -->
        <Button x:Name="NightModeToggle" Content="Night Mode" Margin="627,39,53,364"
                Click="NightModeToggle_Click"/>
        

        <Button x:Name="FontBtn" Content="Font Style" Margin="632,184,53,224" Click="Button_Click"/>



        <ComboBox x:Name="comboBoxLanguages" HorizontalAlignment="Left" Margin="631,301,0,0"
          VerticalAlignment="Top" Width="116" 
           SelectionChanged="comboBoxLanguages_SelectionChanged" Height="23">
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="French" Tag="fr"/>
            <ComboBoxItem Content="German" Tag="de"/>
        </ComboBox>





    </Grid>
</Window>
